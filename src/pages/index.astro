---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import CallToActionButton from '../components/CallToActionButton.astro';
import Features from '../components/Features.astro';
import Order from '../components/Order.astro';
import Scene from '../components/Scene'
import FindUs from '../components/FindUs.astro'
import Loader from '../components/Loader.astro';
import ScrollMenu from '../components/ScrollMenu.astro'
import Footer from '../components/Footer.astro'
---



<Layout class="bg-[#0F0F10] overflow-x-hidden relative">
		<Loader />
		<Header />
			<ScrollMenu />
			<main id="card-scroll-area" class="relative">
				<Hero />
				<Scene className='scene' client:only="react" />
				<CallToActionButton />
				<Features />
				<Order />
				<FindUs />
			</main>
		<Footer />
		
</Layout>

<script>
		document.body.style.overflow = 'hidden'
		window.addEventListener("scene-ready", () => {
		document.getElementById("preloader")?.classList.add("hide")
		document.body.style.overflow = ''

	})
</script>