<script>
    import {gsap} from 'gsap'
    import {ScrollTrigger} from 'gsap/ScrollTrigger'

    gsap.registerPlugin(ScrollTrigger)

    const footerLogo = document.getElementById('footer-logo')
    const footerMenuItem = document.querySelectorAll('.footer-menu-item')

    console.log("Logo", footerLogo)

    gsap.from(footerLogo, {
        y:20,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: footerLogo,
            start: 'top 85%',
            toggleActions: 'play none none none'
        }
    })

    gsap.from(footerMenuItem, {
        y:20,
        opacity: 0,
        duration: 1,
        ease: 'power2.out',
        stagger: 0.1,
        scrollTrigger: {
            trigger: footerMenuItem,
            start: 'top 85%',
            toggleActions: 'play none none none',
        }
    })


</script>