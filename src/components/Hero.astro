<script>
    import {gsap} from 'gsap'
    import {ScrollTrigger} from 'gsap/ScrollTrigger'

    gsap.registerPlugin(ScrollTrigger)

    const blocks = gsap.utils.toArray('#main-blocks > *')

    gsap.from(blocks, {
       
        x: -200,
        opacity: 0,
        duration: 1,
        stagger: 0.2,
    })

</script>